{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "novelle-reader-web",
  "compatibility_date": "2026-08-27",
  "workers_dev": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "novelle.feralicious.games",
      "custom_domain": true
    }
  ]
}
